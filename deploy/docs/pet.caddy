# Imported by the shared IFIC Caddyfile. PET manual access is temporarily public.
https://pet.next-experiment.org {
    # Authentication temporarily disabled at the operator's request.
    header {
        Cache-Control "private, no-store"
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
    }
    redir /docs /docs/ 308
    handle_path /docs/* {
        root * /srv/pet-docs/site
        encode zstd gzip
        file_server
    }
    handle {
        redir /docs/ 302
    }
}
